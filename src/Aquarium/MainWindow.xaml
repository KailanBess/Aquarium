<Window x:Class="Aquarium.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Aquarium">
  <Grid x:Name="Root" RequestedTheme="Dark" Background="#12121F"><Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#171724" BorderBrush="#30303F" BorderThickness="0,0,1,0"><Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Spacing="12" Margin="8,12,8,8"><Button Content="&#xE700;" FontFamily="Segoe Fluent Icons" FontSize="20" Height="38" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Click="ToggleSidebar" AutomationProperties.Name="Expand or collapse sidebar"/><Image Source="Assets/Aquarium.png" Width="42" Height="42"/></StackPanel><ScrollViewer Grid.Row="1"><StackPanel x:Name="RailButtons" Spacing="4"/></ScrollViewer><StackPanel x:Name="RailFooter" Grid.Row="2" Margin="0,0,0,12"/></Grid></Border>
    <NavigationView x:Name="Navigation" Grid.Column="1" IsPaneVisible="False" PaneDisplayMode="LeftMinimal" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" SelectionChanged="Navigate" OpenPaneLength="200" CompactPaneLength="64" IsPaneToggleButtonVisible="False">
      <NavigationView.PaneHeader>
        <StackPanel Margin="20,24,12,28" Spacing="6"><TextBlock Text="aquarium" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource AquariumAccent}"/><TextBlock Text="YOUR PRIVATE APP COLLECTION" FontSize="10" Foreground="#8CA9B5"/></StackPanel>
      </NavigationView.PaneHeader>
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Home" Tag="Home" Icon="Home"/>
        <NavigationViewItem Content="Store" Tag="Store" Icon="Shop"/>
        <NavigationViewItem Content="App install" Tag="App install" Icon="Add"/>
        <NavigationViewItem Content="Library" Tag="Library" Icon="Library"/>
        <NavigationViewItem Content="Downloads" Tag="Downloads" Icon="Download"/>
        <NavigationViewItem Content="Updates" Tag="Updates" Icon="Refresh"/>
      </NavigationView.MenuItems>
      <NavigationView.PaneFooter><TextBlock Text="PRIVATE APP COLLECTION · DESIGN PREVIEW" Foreground="#8CA9B5" FontSize="10" Margin="24"/></NavigationView.PaneFooter>
      <Grid>
      <ScrollViewer x:Name="PageScroll">
        <StackPanel Margin="24,24,24,28" Spacing="18" MaxWidth="1800" HorizontalAlignment="Stretch">
          <TextBlock Visibility="Collapsed" Text="A Q U A R I U M   /   P R I V A T E" Foreground="{StaticResource AquariumAccent}" FontSize="11"/>
          <TextBlock x:Name="PageTitle" FontSize="30" FontWeight="SemiBold" Text="Home"/>
          <TextBlock x:Name="PageSubtitle" Foreground="#A0B8C3" TextWrapping="Wrap"/>
          <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" />
          <StackPanel x:Name="PageBody" Spacing="16"/>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="AppWorkspace" Visibility="Collapsed" RowSpacing="12" Margin="16,12,16,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="8">
          <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Content="Home" Click="WorkspaceHome" AutomationProperties.Name="Return to app page"/>
            <TextBlock x:Name="WorkspaceTitle" Grid.Column="1" FontSize="22" VerticalAlignment="Center"/>
            <Button x:Name="WorkspaceCloseButton" Grid.Column="2" Content="Close app" Click="WorkspaceClose"/>
          </Grid>
          <TextBlock x:Name="WorkspaceStatus" TextWrapping="Wrap" Foreground="#A0B8C3"/>
        </StackPanel>
        <Grid x:Name="AppSurface" Grid.Row="1" Background="#202020"><TextBlock x:Name="WorkspacePlaceholder" Text="Preparing app workspace…" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      </Grid>
      </Grid>
    </NavigationView>
  </Grid>
</Window>



